# Loose fallback: any valid JSON arg. Generated by gen_tables.py.
root      ::= "{\"tool\":" ws tool (ws "," ws "\"arg\":" ws value)? ws "}"
tool      ::= "\"adopt\"" |
    "\"apply_patch\"" |
    "\"ask_agent\"" |
    "\"browser_click\"" |
    "\"browser_open\"" |
    "\"browser_read\"" |
    "\"browser_type\"" |
    "\"browser_wait\"" |
    "\"declare_goal_complete\"" |
    "\"echo\"" |
    "\"edit_file\"" |
    "\"exec\"" |
    "\"exec_kill\"" |
    "\"exec_poll\"" |
    "\"exec_start\"" |
    "\"fetch_url\"" |
    "\"git\"" |
    "\"git_commit\"" |
    "\"glob_files\"" |
    "\"grep_code\"" |
    "\"http_request\"" |
    "\"ide_edit\"" |
    "\"ide_open\"" |
    "\"ide_read\"" |
    "\"ide_write\"" |
    "\"list_agents\"" |
    "\"list_dir\"" |
    "\"mcp_call\"" |
    "\"mcp_list\"" |
    "\"multi_edit\"" |
    "\"now\"" |
    "\"read_file\"" |
    "\"read_mailbox\"" |
    "\"read_note\"" |
    "\"recall\"" |
    "\"remember\"" |
    "\"run_code\"" |
    "\"share\"" |
    "\"show_command\"" |
    "\"show_file\"" |
    "\"show_find\"" |
    "\"show_url\"" |
    "\"str_replace_editor\"" |
    "\"tell_agent\"" |
    "\"think\"" |
    "\"todo_write\"" |
    "\"web_search\"" |
    "\"window_close\"" |
    "\"window_list\"" |
    "\"window_open\"" |
    "\"window_type\"" |
    "\"write_file\"" |
    "\"write_note\""
value     ::= string | number | object | array | boolean | "null"
object    ::= "{" ws (pair (ws "," ws pair)*)? ws "}"
pair      ::= string ws ":" ws value
array     ::= "[" ws (value (ws "," ws value)*)? ws "]"
boolean   ::= "true" | "false"
string    ::= "\"" char* "\""
char      ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
number    ::= "-"? int frac? exp?
int       ::= "0" | [1-9] [0-9]*
frac      ::= "." [0-9]+
exp       ::= [eE] [+-]? [0-9]+
ws        ::= [ \t\n]*
